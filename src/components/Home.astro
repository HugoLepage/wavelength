---
// Home: wordmark, a little dial that plays a turn on a loop, and the two
// mode cards. local.js binds #btn-home-local and shows #btn-home-resume
// (hidden by default) when a saved game exists; online.js binds
// #btn-home-online.
import '../styles/home.css';
---

<section class="screen home" data-screen="home" aria-labelledby="home-title">
  <div class="home-hero">
    <svg class="home-dial" viewBox="0 0 200 120" aria-hidden="true">
      <defs>
        <clipPath id="home-dial-clip"><path d="M18 104A82 82 0 0 1 182 104Z"></path></clipPath>
      </defs>
      <path class="hd-rim" d="M8 104A92 92 0 0 1 192 104V111Q192 117 186 117H14Q8 117 8 111Z"></path>
      <path class="hd-ticks" d="M15.5 104L9 104M16.54 90.78L12.1 90.08M19.64 77.89L15.36 76.5M24.71 65.64L20.7 63.59M31.64 54.33L28 51.69M40.25 44.25L35.65 39.65M50.33 35.64L47.69 32M61.64 28.71L59.59 24.7M73.89 23.64L72.5 19.36M86.78 20.54L86.08 16.1M100 19.5L100 13M113.22 20.54L113.92 16.1M126.11 23.64L127.5 19.36M138.36 28.71L140.41 24.7M149.67 35.64L152.31 32M159.75 44.25L164.35 39.65M168.36 54.33L172 51.69M175.29 65.64L179.3 63.59M180.36 77.89L184.64 76.5M183.46 90.78L187.9 90.08M184.5 104L191 104"></path>
      <g clip-path="url(#home-dial-clip)">
        <circle class="hd-face" cx="100" cy="104" r="82"></circle>
        <g class="hd-bands">
          <path class="hd-b2" d="M100 104L94.77 24.17A80 80 0 0 1 108.02 24.4Z"></path>
          <path class="hd-b3" d="M100 104L108.02 24.4A80 80 0 0 1 121.04 26.82Z"></path>
          <path class="hd-b4" d="M100 104L121.04 26.82A80 80 0 0 1 133.49 31.35Z"></path>
          <path class="hd-b3" d="M100 104L133.49 31.35A80 80 0 0 1 145.02 37.87Z"></path>
          <path class="hd-b2" d="M100 104L145.02 37.87A80 80 0 0 1 155.32 46.21Z"></path>
          <path class="hd-glow" d="M100 104L121.04 26.82A80 80 0 0 1 133.49 31.35Z"></path>
        </g>
        <g class="hd-shutter">
          <path class="hd-plate" d="M18 104A82 82 0 0 1 182 104Z"></path>
          <path class="hd-wave w1" d="M79.22 92A24 24 0 0 1 120.78 92"></path>
          <path class="hd-wave w2" d="M65.6 79.91A42 42 0 0 1 134.4 79.91"></path>
          <path class="hd-wave w3" d="M54.04 65.43A60 60 0 0 1 145.96 65.43"></path>
        </g>
      </g>
      <path class="hd-needle" d="M97.4 104L99.3 30Q100 27 100.7 30L102.6 104Z"></path>
      <circle class="hd-cap" cx="100" cy="104" r="8.5"></circle>
      <g class="hd-pop">
        <rect x="56" y="54" width="28" height="19" rx="9.5"></rect>
        <text x="70" y="64">+4</text>
      </g>
    </svg>
    <h1 class="home-title" id="home-title">wave<span>length</span></h1>
    <p class="home-tag">Read minds. Turn the dial.</p>
  </div>

  <button class="btn primary home-resume hidden" id="btn-home-resume" type="button">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" fill="currentColor"></path></svg>
    <span class="btn-label">Resume game</span>
    <span class="resume-meta" id="home-resume-meta"></span>
  </button>

  <div class="mode-cards">
    <button class="mode-card mode-local" id="btn-home-local" type="button">
      <span class="mode-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48">
          <rect class="mi-fill" x="15" y="7" width="18" height="32" rx="4.5"></rect>
          <path class="mi-screen" d="M18.5 24a5.5 5.5 0 0 1 11 0z"></path>
          <path class="mi-needle" d="M24 24l3-4.2"></path>
          <path class="mi-line" d="M8.5 31.5a17 17 0 0 1-1-14.5M5 19.5l2.6-3.2 3.3 2.4"></path>
          <path class="mi-line" d="M39.5 16.5a17 17 0 0 1 1 14.5M43 28.5l-2.6 3.2-3.3-2.4"></path>
        </svg>
      </span>
      <span class="mode-name">Pass &amp; play</span>
      <span class="mode-sub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="2.5" fill="currentColor"></rect></svg>
        1 device
      </span>
    </button>
    <button class="mode-card mode-online" id="btn-home-online" type="button">
      <span class="mode-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48">
          <rect class="mi-fill" x="4.5" y="12" width="14" height="25" rx="3.5"></rect>
          <rect class="mi-fill" x="29.5" y="12" width="14" height="25" rx="3.5"></rect>
          <path class="mi-line" d="M21.5 20.5a5 5 0 0 1 0 8M25.5 17a10 10 0 0 1 0 15"></path>
          <circle class="mi-screen" cx="11.5" cy="23" r="3.2"></circle>
          <circle class="mi-screen" cx="36.5" cy="23" r="3.2"></circle>
        </svg>
      </span>
      <span class="mode-name">Online</span>
      <span class="mode-sub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8.5" cy="8.5" r="3.5" fill="currentColor"></circle><circle cx="15.5" cy="8.5" r="3.5" fill="currentColor"></circle><path d="M2 20a6.5 6.5 0 0 1 13 0zM9 20a6.5 6.5 0 0 1 13 0z" fill="currentColor"></path></svg>
        Co-op duo
      </span>
    </button>
  </div>
</section>
