---
// The one page shell: meta, fonts, favicon, global styles, and the tiny
// pre-paint scripts (?session, theme, spicy mode) that must run before
// anything shows.
import '../styles/base.css';

interface Props {
  title?: string;
}
const { title = 'Wavelength' } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5f1ea" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Wavelength — the mind-reading party game. Give a clue, turn the dial, find the target. Pass & play on one device or team up online." />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Nunito:wght@500..900&display=swap"
    />
    <title>{title}</title>
    <!-- A ?session link goes straight to an online room: hide the home screen
         before first paint so it never flashes (online.js lifts this again). -->
    <script is:inline>
      if (/[?&]session=/.test(location.search)) document.documentElement.classList.add('joining');
    </script>
    <!-- The theme is stamped before first paint too, so a dark-mode player
         never gets a full screen of cream on the way in. ui.js imports
         theme.js as a module, which Astro defers — far too late for this.
         An is:inline script cannot import, so the storage key, the data-theme
         values and the two theme-color hexes are repeated from
         src/scripts/theme.js; keep the two in sync. -->
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('wavelength.theme');
        } catch (e) {
          /* private mode: fall through to the system preference */
        }
        var dark = saved === 'dark' || (saved !== 'light' &&
          typeof matchMedia === 'function' &&
          matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#0f1222' : '#f5f1ea');
      })();
    </script>
    <!-- Spicy mode, likewise: the chili in the top bar is coloured from
         <html data-spicy>, so it is stamped before first paint and a spicy
         player never sees the outline flash red. The storage key is repeated
         from src/scripts/spicy.js; keep the two in sync. -->
    <script is:inline>
      (function () {
        var spicy = null;
        try {
          spicy = localStorage.getItem('wavelength.spicy');
        } catch (e) {
          /* private mode: off */
        }
        document.documentElement.setAttribute('data-spicy', spicy === '1' ? 'on' : 'off');
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
